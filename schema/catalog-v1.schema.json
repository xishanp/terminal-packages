{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xishanp/terminal-packages/schema/catalog-v1.schema.json",
  "title": "Terminal package catalogue v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "minimumClientVersion", "androidSources", "androidDevelopmentApps", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "terminal" },
    "name": { "const": "Terminal Official" },
    "minimumClientVersion": { "type": "string", "minLength": 1 },
    "androidSources": { "type": "array", "minItems": 3 },
    "androidDevelopmentApps": { "type": "array" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "artifactFormat", "state", "license", "abis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "artifactFormat": { "const": "terminal-native-runtime-v1" },
          "state": { "enum": ["building", "available"] },
          "license": { "type": "string", "minLength": 1 },
          "abis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64", "all"] }
          },
          "version": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "codeArtifacts": { "type": "array" },
          "dataArtifacts": { "type": "array" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
